<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChattyValley.Core\ChattyValley.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\packaging\config.release.json" Link="packaging\config.release.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\ChattyValley.Mod\manifest.json" Link="packaging\manifest.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\ChattyValley.Mod\ModConfig.cs" Link="packaging\ModConfig.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\ChattyValley.Mod\ModEntry.cs" Link="packaging\ModEntry.cs"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\characters\linus.json" Link="packaging\linus.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fixtures\false-premise-cases.json"
             Link="fixtures\false-premise-cases.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>