<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net6.0 on purpose: this is the code the SMAPI mod will reuse verbatim, and SMAPI mods target
    net6.0. No external dependencies here, so it stays mod-safe. LLamaSharp lives in the Harness.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

</Project>
