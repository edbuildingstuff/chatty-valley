<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net8.0 so this library and its net10 consumers (sidecar + harness) bind to the SAME LLamaSharp
    assembly. LLamaSharp 0.27.0 ships exactly two builds, lib/netstandard2.0 and lib/net8.0. A net6.0
    target here resolves netstandard2.0 (net6.0 cannot consume a net8.0 assembly), while a net10 host
    resolves net8.0 as the closest usable build. So on net6.0 the assembly compiled against and the
    assembly loaded at runtime are two different files. That configuration failed with
    "Method not found: set_Temperature" the first time a sampling temperature was set.

    Caveat, so nobody re-derives a wrong cause from this note: the member-level reason for that
    specific exception was never established. Inspected via MetadataLoadContext, DefaultSamplingPipeline
    .Temperature is declared identically in both builds (same declaring type, System.Single, getter and
    setter present). Treat the compile-vs-runtime resolution split as the cause and the exception as a
    symptom. Verify with `obj/project.assets.json`, which should show lib/net8.0 for both compile and
    runtime here and in ChattyValley.Sidecar.

    The SMAPI mod is a thin client and does NOT reference this project, so it stays free of LLamaSharp's
    .NET 10 dependency chain.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ChattyValley.Runtime</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChattyValley.Core\ChattyValley.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
  </ItemGroup>

</Project>
